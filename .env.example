PORT=3001
HOST_ORIGIN=http://localhost:5173
CONTROLLER_ORIGIN=http://localhost:5174

# Set to true to enable single-room mode (home use):
# - exposes GET /room-code so controllers can auto-fill the code
# SINGLE_ROOM_MODE=true

# Enables the content admin editors under /admin (geo, kviz, ko-sam-ja,
# tajni-agenti, scenariji) and their /api/admin/* CRUD routes. Pick any
# secret string; without it the editors stay disabled.
# ADMIN_TOKEN=promeni-me
